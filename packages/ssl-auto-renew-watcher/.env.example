# Number of days before certificate expiry to start warning. Defaults to 14 if unset.
SSL_WARNING_DAYS=14

# Discord webhook URL for renewal alerts — leave empty to disable
DISCORD_WEBHOOK_URL=

# Slack incoming webhook URL for renewal alerts — leave empty to disable
SLACK_WEBHOOK_URL=

# Path to the JSON file listing hosts to watch. Defaults to ./ssl-watch.config.json if unset.
SSL_WATCH_CONFIG_PATH=./ssl-watch.config.json
