# HTTP port the dashboard server listens on.
# PORT=3000

# How often (ms) every configured target is checked.
# UPTIME_CHECK_INTERVAL_MS=60000

# Where the SQLite history file lives (created automatically, gitignored).
# UPTIME_DB_PATH=./data/uptime.sqlite

# Path to the JSON file listing monitored targets. See uptime.config.example.json.
# UPTIME_CONFIG_PATH=./uptime.config.json
